CREATE TABLE denmark_grocery_items (
    items_id INT PRIMARY KEY,
    brand_name VARCHAR(100),
    product_name VARCHAR(150),
    category VARCHAR(50),
    package_size VARCHAR(50),
    unit_price DECIMAL(10,2),
    expiration_date DATE,
    date_added DATETIME
);

